# Path to the OAuth client file downloaded from Google Cloud Console
GOOGLE_CLIENT_SECRETS=client_secret.json
# Any long random string; used to sign the session cookie
FLASK_SECRET_KEY=change-me
# Only for local development over http://localhost
OAUTHLIB_INSECURE_TRANSPORT=1
OAUTHLIB_RELAX_TOKEN_SCOPE=1

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
# Starting defaults; any model installed on the machine can be chosen per run
# (drop-down on the check page, or --model on the command line).
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=8192
# Context window of the embedding model (nomic-embed-text is 2048, not 8192)
OLLAMA_EMBED_NUM_CTX=2048
# Prompts are packed to fit num_ctx using this estimate. Measured on qwen2.5:7b:
# 5.2 chars/token English, 3.9 Vietnamese, 3.3 code. Lower it if prompts overflow.
OLLAMA_CHARS_PER_TOKEN=3.0
# Tokens reserved for the model's reply (also caps it, via num_predict)
OLLAMA_REPLY_TOKENS=700

# Where condensed model-answer keys are cached (one file per answer sheet)
ANSWER_KEYS_DIR=answer_keys

# Running student code: "docker" (isolated, recommended) or "local" (no isolation)
CODE_RUNNER=docker
CODE_TIMEOUT=10
CODE_MEMORY_MB=256
