# Path to the OAuth client file downloaded from Google Cloud Console
GOOGLE_CLIENT_SECRETS=client_secret.json
# Any long random string; used to sign the session cookie
FLASK_SECRET_KEY=change-me
# Only for local development over http://localhost
OAUTHLIB_INSECURE_TRANSPORT=1
OAUTHLIB_RELAX_TOKEN_SCOPE=1

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=8192

# Running student code: "docker" (isolated, recommended) or "local" (no isolation)
CODE_RUNNER=docker
CODE_TIMEOUT=10
CODE_MEMORY_MB=256
